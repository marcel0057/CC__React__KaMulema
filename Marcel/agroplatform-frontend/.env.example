# =========================================================
# AgroPlatform Frontend — Variables d'environnement
# Copie ce fichier en .env.local et remplis les valeurs
# =========================================================

# URL du backend Spring Boot
VITE_API_URL=http://localhost:8086

# URL WebSocket
VITE_WS_URL=http://localhost:8086/ws

# Clé API Google Maps
# Obtenir sur : https://console.cloud.google.com/
# APIs à activer : Maps JavaScript API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=REMPLACE_PAR_TA_CLE_API
